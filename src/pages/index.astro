---
import Layout from "../layouts/Layout.astro";
import App from "../components/App";
import { getCollection } from "astro:content";
import "@/styles/global.css";

const projects = await getCollection("projects");
const projectData = projects
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({ slug: p.slug, ...p.data }));

const awards = await getCollection("awards");
const awardData = awards
  .sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order)
  .map((a) => ({ slug: a.slug, body: a.body, ...a.data }));
---

<Layout>
  <App client:load projects={projectData} awards={awardData} />
</Layout>
