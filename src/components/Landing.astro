<script>
	// @ts-nocheck
	import { gsap } from 'gsap';
	import { animate } from 'motion';
	import * as THREE from 'three';
	import { horizontalLoop } from '../utils/helper';

	window.addEventListener('DOMContentLoaded', () => {
		const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
		tl.from('.alias.zh', { y: 80, opacity: 0, duration: 1 })
			.from('.alias.en', { y: 80, opacity: 0, duration: 1 }, '-=0.8')
			.from('.tagline', { y: 60, opacity: 0, duration: 1 }, '-=0.6');

		// Motion one scroll indicator animation
		// @ts-ignore – Motion typings don't cover this overload but runtime works
		(animate as any)(
			'.scroll-down span',
			{ y: [0, 10], opacity: [1, 0] },
			{ duration: 1.4, repeat: Infinity, easing: 'ease-in-out', direction: 'alternate' }
		);

		// Delay the loop setup to ensure all rendering is complete
		gsap.delayedCall(0.1, () => {
			horizontalLoop(gsap.utils.toArray('.banner.top .track span'), {
				repeat: -1,
				speed: 0.6,
				reversed: false,
				paddingRight: parseFloat(getComputedStyle(document.querySelector('.banner.top .track span')).marginRight) || 0
			});

			horizontalLoop(gsap.utils.toArray('.banner.bottom .track span'), {
				repeat: -1,
				speed: 0.6,
				reversed: true,
				paddingRight: parseFloat(getComputedStyle(document.querySelector('.banner.bottom .track span')).marginRight) || 0
			});
		});

		// Three.js background
		const canvas = document.getElementById('gl-canvas');
		if (canvas) {
			const scene = new THREE.Scene();
			const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
			const renderer = new THREE.WebGLRenderer({ canvas: canvas });
			renderer.setSize(window.innerWidth, window.innerHeight);

			const vertexShader = `
				void main() {
					gl_Position = vec4(position, 1.0);
				}
			`;

			const fragmentShader = `
				uniform vec2 u_resolution;
				uniform float u_time;

				// 2D Random
				float random (in vec2 st) {
						return fract(sin(dot(st.xy,
																 vec2(12.9898,78.233)))
												 * 43758.5453123);
				}

				// 2D Noise based on Morgan McGuire @morgan3d
				// https://www.shadertoy.com/view/4dS3Wd
				float noise (in vec2 st) {
						vec2 i = floor(st);
						vec2 f = fract(st);

						// Four corners in 2D of a tile
						float a = random(i);
						float b = random(i + vec2(1.0, 0.0));
						float c = random(i + vec2(0.0, 1.0));
						float d = random(i + vec2(1.0, 1.0));

						vec2 u = f * f * (3.0 - 2.0 * f);
						return mix(a, b, u.x) +
										(c - a)* u.y * (1.0 - u.x) +
										(d - b) * u.x * u.y;
				}

				void main() {
					vec2 st = gl_FragCoord.xy/u_resolution.xy;
					st.x *= u_resolution.x/u_resolution.y;

					float n = noise(st * 3.0 + u_time * 0.1);

					vec3 color1 = vec3(0.0, 0.015, 0.156); // #000428
					vec3 color2 = vec3(0.235, 0.231, 0.572); // #3c3b92

					vec3 color = mix(color1, color2, smoothstep(0.3, 0.7, n));

					// Add dithering to reduce color banding
					color += (random(gl_FragCoord.xy) - 0.5) / 255.0;

					gl_FragColor = vec4(color,1.0);
				}
			`;

			const uniforms = {
				u_time: { value: 0.0 },
				u_resolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) }
			};

			const geometry = new THREE.PlaneGeometry(2, 2);
			const material = new THREE.ShaderMaterial({
				vertexShader,
				fragmentShader,
				uniforms
			});
			const plane = new THREE.Mesh(geometry, material);
			scene.add(plane);

			const clock = new THREE.Clock();

			function animate() {
				requestAnimationFrame(animate);
				uniforms.u_time.value = clock.getElapsedTime();
				renderer.render(scene, camera);
			}

			animate();

			window.addEventListener('resize', () => {
				renderer.setSize(window.innerWidth, window.innerHeight);
				uniforms.u_resolution.value.set(window.innerWidth, window.innerHeight);
			});
		}
	});
</script>

